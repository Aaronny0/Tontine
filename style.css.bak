<span class="text-2xl font-black text-[#003527] dark:text-[#D4AF37] font-headline tracking-tight">TontineChain</span>
</div>
<button class="text-[#064E3B] dark:text-[#E8F5E9] hover:opacity-80 transition-opacity">
<span class="material-symbols-outlined text-2xl" data-icon="notifications">notifications</span>
</button>
</header>
<main class="max-w-7xl mx-auto px-6 mt-8">
