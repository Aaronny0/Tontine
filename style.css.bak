</div>
<div class="flex-1 flex items-center justify-between bg-surface-container-low p-4 rounded-xl">
<div>
<p class="text-xs font-bold text-primary/60 uppercase">Avril 2024</p>
<h3 class="font-bold text-primary">Kadiatou Diallo</h3>
</div>
</div>
</div>
</div>
</div>
<!-- Members List Section -->
<div class="space-y-6">
<h2 class="text-2xl font-extrabold text-primary">Membres Actifs</h2>
<div class="bg-surface-container-low rounded-[2rem] p-6 space-y-4">
<!-- Member Card -->
<div class="flex items-center gap-4 bg-surface-container-lowest p-3 rounded-2xl shadow-sm">
<div class="w-12 h-12 rounded-full overflow-hidden">
<img class="w-full h-full object-cover" data-alt="Portrait of a smiling West African woman, natural lighting, park background" src="https://lh3.googleusercontent.com/aida-public/AB6AXuCxmFVZmHJkGyhcrP4N7qOKQfdzhuVlGVKa1TwzugwQAr7Bom7VFklXCBc3OybDRQKAHVKhC5mfQtk0HgFjq0dICZ5qBaZx60Za9coYAKIUEoXRD7MVErQEXy74ip3R4Yoe1hdl3UjGD5m7DbsgK7cgYrYMrN4T0wwu_5KUTAyJiH4iFp4rpG6wBSBektljTtAql5f4gzsY8r8wqjaj4quWYe2-KJLLWvDOSzO02CFnNTc3JjUWdURd-R35ED15J0dC9NZKsQ4q27k"/>
