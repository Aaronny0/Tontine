</button>
<button class="flex items-center justify-center gap-2 bg-secondary-container text-on-secondary-container py-4 rounded-xl shadow-md hover:opacity-90 transition-opacity">
<span class="material-symbols-outlined">description</span>
<span class="font-bold font-['Manrope']">Voir le contrat</span>
</button>
</div>
<div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
<!-- Timeline Section (Visual Tour de Rôle) -->
<div class="lg:col-span-2 space-y-6">
<div class="flex items-center justify-between">
<h2 class="text-2xl font-extrabold text-primary">Calendrier des Allocations</h2>
<span class="text-primary/60 text-sm font-semibold">Cycle de 12 mois</span>
</div>
<div class="bg-surface-container-lowest rounded-[2rem] p-6 space-y-8 relative overflow-hidden">
<!-- Progress Line -->
<div class="absolute left-[2.25rem] top-10 bottom-10 w-0.5 bg-outline-variant/30"></div>
<!-- Timeline Item: Past -->
<div class="relative flex items-center gap-6 opacity-60">
<div class="w-6 h-6 rounded-full bg-primary-container flex items-center justify-center z-10">
<span class="material-symbols-outlined text-[14px] text-white" style="font-variation-settings: 'FILL' 1;">check_circle</span>
</div>
<div class="flex-1 flex items-center justify-between bg-surface-container-low p-4 rounded-xl">
<div>
<p class="text-xs font-bold text-primary/60 uppercase">Janvier 2024</p>
<h3 class="font-bold text-primary">Moussa Traoré</h3>
</div>
<span class="text-sm font-bold text-primary">Reçu</span>
</div>
</div>
<!-- Timeline Item: Active -->
<div class="relative flex items-center gap-6">
<div class="w-10 h-10 -ml-2 rounded-full bg-secondary-container flex items-center justify-center z-10 shadow-lg border-4 border-surface-container-lowest">
<span class="material-symbols-outlined text-on-secondary-container" style="font-variation-settings: 'FILL' 1;">stars</span>
</div>
<div class="flex-1 flex items-center justify-between bg-white p-5 rounded-2xl shadow-[0_10px_40px_rgba(0,53,39,0.08)] border-t-4 border-secondary-container">
<div>
<p class="text-xs font-bold text-secondary uppercase tracking-wider">Février 2024 (En cours)</p>
<h3 class="font-black text-xl text-primary">Fatou Sow</h3>
</div>
<div class="text-right">
