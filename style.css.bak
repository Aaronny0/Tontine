<!DOCTYPE html>

<html class="light" lang="fr"><head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1.0" name="viewport"/>
<title>Créer une Tontine - TontineChain</title>
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;700;800&amp;family=Plus+Jakarta+Sans:wght@400;500;600;700&amp;display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
<script id="tailwind-config">
      tailwind.config = {
        darkMode: "class",
        theme: {
          extend: {
            "colors": {
                    "outline-variant": "#bfc9c3",
                    "tertiary-container": "#5a4000",
                    "on-tertiary": "#ffffff",
                    "surface-variant": "#e4e2de",
                    "tertiary-fixed": "#ffdea4",
                    "on-error": "#ffffff",
                    "tertiary-fixed-dim": "#f0bf5d",
                    "surface-container-highest": "#e4e2de",
                    "on-background": "#1b1c1a",
                    "surface-container": "#efeeea",
                    "inverse-on-surface": "#f2f0ed",
                    "surface-container-high": "#eae8e4",
                    "on-secondary": "#ffffff",
                    "on-primary-fixed-variant": "#0b513d",
                    "on-surface": "#1b1c1a",
                    "surface": "#fbf9f5",
                    "secondary-fixed-dim": "#e9c349",
                    "primary": "#003527",
                    "secondary": "#735c00",
                    "on-error-container": "#93000a",
                    "primary-container": "#064e3b",
                    "secondary-container": "#fed65b",
                    "secondary-fixed": "#ffe088",
                    "on-tertiary-fixed-variant": "#5d4200",
                    "background": "#fbf9f5",
                    "primary-fixed": "#b0f0d6",
                    "surface-dim": "#dbdad6",
                    "surface-container-lowest": "#ffffff",
                    "on-secondary-fixed": "#241a00",
                    "primary-fixed-dim": "#95d3ba",
                    "on-tertiary-fixed": "#261900",
                    "on-tertiary-container": "#daab4b",
                    "on-primary": "#ffffff",
                    "error": "#ba1a1a",
                    "on-surface-variant": "#404944",
                    "on-primary-container": "#80bea6",
                    "outline": "#707974",
                    "surface-container-low": "#f5f3ef",
                    "surface-tint": "#2b6954",
                    "tertiary": "#3e2b00",
                    "inverse-surface": "#30312e",
                    "error-container": "#ffdad6",
                    "inverse-primary": "#95d3ba",
                    "on-secondary-fixed-variant": "#574500",
                    "on-secondary-container": "#745c00",
                    "surface-bright": "#fbf9f5",
                    "on-primary-fixed": "#002117"
            },
            "borderRadius": {
                    "DEFAULT": "0.25rem",
                    "lg": "0.5rem",
                    "xl": "0.75rem",
                    "full": "9999px"
            },
            "fontFamily": {
                    "headline": ["Manrope"],
                    "body": ["Plus Jakarta Sans"],
                    "label": ["Plus Jakarta Sans"]
            }
          },
        },
      }
    </script>
<style>
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }
        .textile-pattern {
            background-color: transparent;
            background-image:  radial-gradient(#003527 0.5px, transparent 0.5px), radial-gradient(#003527 0.5px, #fbf9f5 0.5px);
            background-size: 20px 20px;
            background-position: 0 0,10px 10px;
            opacity: 0.03;
        }
    </style>
<style>
    body {
      min-height: max(884px, 100dvh);
    }
  </style>
  </head>
<body class="bg-background font-body text-on-background min-h-screen">
<!-- TopAppBar -->
<header class="bg-[#FDFBF7] dark:bg-[#001A13] flex justify-between items-center px-6 py-4 w-full z-50 backdrop-blur-md sticky top-0">
<div class="flex items-center gap-3">
<div class="w-10 h-10 rounded-full bg-primary-container overflow-hidden">
<img alt="Avatar" data-alt="portrait of a professional West African man in elegant traditional attire, soft studio lighting" src="https://lh3.googleusercontent.com/aida-public/AB6AXuC5OWKemAt04c6giBw2Zk7RkKl6oM66Xlc1RHXFDPot6l8J_mFyxbDU0h8qsxIkFusPVeVs5G8As3mGbIYRhu6sE4ocTOJlMEZKjvklfotHXduoU_fw7BKJ3FQ4ABlRjcOVHxAETn3-Vu1rLIf4oUzvhdEWqqYL7KNtJ7Ln6KjRvspqFDtTS2O_Y0yZle7yr68WZjhsmY77seDM0GSNcZRSEO_5a5ey1wykK5Mmap0FDRKvBHMkSvGz8VSr51XwujSg8QvrZwG3srU"/>
</div>
<span class="font-['Manrope'] font-bold text-xl text-[#003527] dark:text-[#D4AF37]">TontineChain</span>
</div>
<button class="text-[#064E3B] dark:text-[#E8F5E9] hover:opacity-80 transition-opacity">
<span class="material-symbols-outlined" data-icon="notifications">notifications</span>
</button>
</header>
<main class="max-w-5xl mx-auto px-6 py-8 pb-32">
<div class="mb-10">
<h1 class="font-headline font-extrabold text-4xl text-primary tracking-tight mb-2">Initier un Nouvel Héritage</h1>
<p class="text-on-surface-variant font-medium">Configurez votre tontine intelligente en quelques étapes sécurisées.</p>
</div>
<div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
<!-- Form Section -->
<div class="lg:col-span-7 space-y-8">
<section class="bg-surface-container-lowest rounded-xl p-8 relative overflow-hidden">
<div class="absolute top-0 left-0 w-full h-1 textile-pattern opacity-10"></div>
<div class="space-y-6">
<!-- Nom -->
<div class="group">
<label class="block font-label font-semibold text-sm text-primary mb-3 ml-1">Nom de la tontine</label>
<input class="w-full bg-surface-container-low border-none rounded-xl px-4 py-4 text-on-surface placeholder:text-outline focus:ring-2 focus:ring-primary transition-all" placeholder="Ex: Solidarité Familiale 2024" type="text"/>
</div>
<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
<!-- Montant -->
<div>
<label class="block font-label font-semibold text-sm text-primary mb-3 ml-1">Cotisation individuelle</label>
<div class="relative">
<input class="w-full bg-surface-container-low border-none rounded-xl px-4 py-4 pr-12 text-on-surface focus:ring-2 focus:ring-primary transition-all" placeholder="50 000" type="number"/>
<span class="absolute right-4 top-1/2 -translate-y-1/2 font-bold text-primary-container">FCFA</span>
</div>
</div>
<!-- Membres -->
<div>
<label class="block font-label font-semibold text-sm text-primary mb-3 ml-1">Nombre de membres</label>
<div class="relative">
<input class="w-full bg-surface-container-low border-none rounded-xl px-4 py-4 text-on-surface focus:ring-2 focus:ring-primary transition-all" placeholder="12" type="number"/>
<span class="absolute right-4 top-1/2 -translate-y-1/2 material-symbols-outlined text-outline">group</span>
</div>
</div>
</div>
<!-- Fréquence -->
<div>
<label class="block font-label font-semibold text-sm text-primary mb-3 ml-1">Fréquence des cycles</label>
<div class="grid grid-cols-2 gap-4">
<button class="flex items-center justify-center gap-2 py-4 rounded-xl border-2 border-primary bg-primary-container/5 text-primary font-bold transition-all">
<span class="material-symbols-outlined" data-icon="calendar_view_week">calendar_view_week</span>
                                    Hebdomadaire
                                </button>
<button class="flex items-center justify-center gap-2 py-4 rounded-xl border-2 border-transparent bg-surface-container-low text-on-surface-variant font-medium hover:bg-surface-container-high transition-all">
<span class="material-symbols-outlined" data-icon="calendar_month">calendar_month</span>
                                    Mensuel
                                </button>
</div>
</div>
<!-- Public Toggle -->
<div class="flex items-center justify-between p-4 bg-surface-container-high/50 rounded-xl">
<div class="flex flex-col">
<span class="font-bold text-primary">Appel à membres</span>
<span class="text-xs text-on-surface-variant">Rendre cette tontine visible sur l'explorateur</span>
</div>
<label class="relative inline-flex items-center cursor-pointer">
<input class="sr-only peer" type="checkbox" value=""/>
<div class="w-11 h-6 bg-outline-variant peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full rtl:peer-checked:after:-translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:start-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-primary"></div>
</label>
</div>
</div>
</section>
</div>
<!-- Preview/Simulation Section -->
<div class="lg:col-span-5">
<div class="sticky top-28 space-y-6">
<div class="bg-primary text-on-primary rounded-xl p-8 relative overflow-hidden shadow-xl">
<div class="absolute inset-0 textile-pattern opacity-10"></div>
<h3 class="font-headline text-on-primary-container text-xs uppercase tracking-widest mb-6">Simulation du Contrat</h3>
<div class="space-y-6 relative z-10">
<div>
<p class="text-primary-fixed-dim text-sm mb-1">Total à recevoir par cycle</p>
<p class="text-4xl font-headline font-black text-secondary-container">600 000 <span class="text-lg font-medium opacity-80">FCFA</span></p>
</div>
<div class="pt-6 border-t border-white/10 space-y-4">
<div class="flex justify-between items-center text-sm">
<span class="opacity-70">Durée totale du cycle</span>
<span class="font-bold">12 semaines</span>
</div>
<div class="flex justify-between items-center text-sm">
<span class="opacity-70">Frais de réseau (Gas)</span>
<span class="font-bold text-secondary-container">~0.002 ETH</span>
</div>
<div class="flex justify-between items-center text-sm">
<span class="opacity-70">Sécurité</span>
<span class="flex items-center gap-1 font-bold text-primary-fixed">
                                        Vérifié <span class="material-symbols-outlined text-[16px]" style="font-variation-settings: 'FILL' 1;">verified_user</span>
</span>
</div>
</div>
</div>
</div>
<button class="w-full bg-secondary-container text-on-secondary-container font-headline font-extrabold py-5 rounded-xl shadow-lg hover:shadow-secondary-container/20 hover:-translate-y-1 transition-all flex items-center justify-center gap-3">
<span class="material-symbols-outlined" data-icon="account_balance_wallet">account_balance_wallet</span>
                        Créer le contrat intelligent
                    </button>
<p class="text-center text-[10px] text-outline px-4 uppercase tracking-tighter">
                        En créant ce contrat, vous acceptez les règles d'intégrité de la communauté TontineChain.
                    </p>
</div>
</div>
</div>
</main>
<!-- BottomNavBar -->
<nav class="fixed bottom-0 left-0 w-full flex justify-around items-center px-4 pt-3 pb-8 backdrop-blur-xl bg-[#FDFBF7]/80 dark:bg-[#001A13]/80 z-50 rounded-t-[24px] shadow-[0_-8px_30px_rgb(0,53,39,0.06)] md:hidden">
<a class="flex flex-col items-center justify-center text-[#064E3B]/40 dark:text-white/30 font-medium text-[10px]" href="#">
<span class="material-symbols-outlined" data-icon="dashboard">dashboard</span>
            Accueil
        </a>
<a class="flex flex-col items-center justify-center text-[#064E3B]/40 dark:text-white/30 font-medium text-[10px]" href="#">
<span class="material-symbols-outlined" data-icon="explore">explore</span>
            Explorer
        </a>
<a class="flex flex-col items-center justify-center text-[#064E3B] dark:text-[#D4AF37] font-bold text-[10px]" href="#">
<span class="material-symbols-outlined" data-icon="add_circle" style="font-variation-settings: 'FILL' 1;">add_circle</span>
            Créer
        </a>
<a class="flex flex-col items-center justify-center text-[#064E3B]/40 dark:text-white/30 font-medium text-[10px]" href="#">
<span class="material-symbols-outlined" data-icon="history_edu">history_edu</span>
            Contrats
        </a>
<a class="flex flex-col items-center justify-center text-[#064E3B]/40 dark:text-white/30 font-medium text-[10px]" href="#">
<span class="material-symbols-outlined" data-icon="person">person</span>
            Profil
        </a>
</nav>
<!-- Web Navigation (Desktop Only) -->
<nav class="hidden md:flex fixed left-0 top-0 h-full w-24 flex-col items-center py-24 bg-surface-container-low border-r border-transparent z-40">
<div class="space-y-12 flex flex-col items-center">
<a class="text-primary/40 hover:text-primary transition-colors" href="#">
<span class="material-symbols-outlined text-3xl">dashboard</span>
</a>
<a class="text-primary/40 hover:text-primary transition-colors" href="#">
<span class="material-symbols-outlined text-3xl">explore</span>
</a>
<a class="text-primary transition-colors relative" href="#">
<span class="material-symbols-outlined text-3xl" style="font-variation-settings: 'FILL' 1;">add_circle</span>
<div class="absolute -right-2 top-1/2 -translate-y-1/2 w-1 h-8 bg-primary rounded-full"></div>
</a>
<a class="text-primary/40 hover:text-primary transition-colors" href="#">
<span class="material-symbols-outlined text-3xl">history_edu</span>
</a>
<a class="text-primary/40 hover:text-primary transition-colors" href="#">
<span class="material-symbols-outlined text-3xl">person</span>
</a>
</div>
</nav>
</body></html>
