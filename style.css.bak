<span class="w-2 h-2 rounded-full bg-white"></span>
</div>
<div class="flex-1 flex items-center justify-between bg-surface-container-lowest border-2 border-dashed border-outline-variant/30 p-4 rounded-xl">
<div>
<p class="text-xs font-bold text-primary/40 uppercase">Mars 2024</p>
<h3 class="font-bold text-primary">Vous (Samba Camara)</h3>
</div>
