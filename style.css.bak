</div>
</div>
<!-- Info & CTA -->
<div class="flex-1 text-center md:text-left space-y-2">
<h2 class="text-3xl font-headline font-extrabold tracking-tight text-primary">Koffi Mensah</h2>
<p class="text-on-surface-variant font-medium">koffi.mensah@patrimoine.tg</p>
<div class="pt-4 flex flex-wrap gap-3 justify-center md:justify-start">
<span class="bg-primary-container text-on-primary-container px-4 py-1.5 rounded-full text-sm font-semibold flex items-center gap-2">
<span class="material-symbols-outlined text-base">account_balance_wallet</span>
                            0x71C...4f2E
                        </span>
<span class="bg-surface-container-high text-on-surface-variant px-4 py-1.5 rounded-full text-sm font-semibold">Membre depuis 2022</span>
</div>
</div>
<!-- Trust Score Highlight -->
<div class="bg-primary text-white p-6 rounded-xl w-full md:w-48 flex flex-col items-center justify-center text-center gap-1 shadow-xl">
<p class="text-[10px] uppercase tracking-widest font-bold opacity-70">Trust Score</p>
<div class="text-4xl font-headline font-black text-secondary-container">98<span class="text-lg">/100</span></div>
<div class="mt-2 bg-secondary/20 text-secondary-fixed text-[10px] px-3 py-1 rounded-full font-bold uppercase tracking-tighter border border-secondary/30">
                        Membre Élite
                    </div>
</div>
</div>
</section>
<!-- Bento Grid for Stats & Actions -->
<section class="grid grid-cols-1 md:grid-cols-3 gap-6">
<!-- Wallet Status Card -->
<div class="md:col-span-2 bg-surface-container-low rounded-xl p-8 relative overflow-hidden flex flex-col justify-between">
<div class="pattern-overlay absolute inset-0 opacity-40"></div>
<div class="relative z-10">
<div class="flex justify-between items-start mb-8">
<div>
<p class="text-label-md text-on-surface-variant font-medium">Patrimoine Total Estimé</p>
<h3 class="text-4xl font-headline font-black text-primary mt-1">4.250.000 <span class="text-xl font-bold">XOF</span></h3>
</div>
<div class="bg-primary-container/10 p-3 rounded-xl text-primary">
<span class="material-symbols-outlined text-2xl">account_balance</span>
</div>
</div>
<div class="flex gap-4">
<button class="bg-primary text-on-primary px-6 py-3 rounded-xl font-bold flex-1 flex items-center justify-center gap-2 hover:opacity-90 transition-opacity">
<span class="material-symbols-outlined text-lg">add</span> Déposer
                        </button>
<button class="bg-transparent border border-outline-variant/30 text-primary px-6 py-3 rounded-xl font-bold flex-1 flex items-center justify-center gap-2 hover:bg-surface-container-high transition-colors">
<span class="material-symbols-outlined text-lg">payments</span> Retirer
                        </button>
</div>
</div>
</div>
<!-- Security Quick Check -->
<div class="bg-surface-container-highest rounded-xl p-6 flex flex-col justify-between">
