<div class="flex justify-end mt-1">
<span class="text-[9px] text-on-surface-variant font-medium">12:05</span>
</div>
</div>
</div>
</div>
</main>
<!-- Message Input Section -->
<footer class="bg-surface-container-low px-4 pt-4 pb-8 backdrop-blur-xl border-t border-primary/5">
