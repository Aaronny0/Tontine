<img class="w-full h-full object-cover" data-alt="Portrait of a young West African woman with professional attire and a confident smile in soft daylight" src="https://lh3.googleusercontent.com/aida-public/AB6AXuAm5S2p4r-gcFtxS93aqSXREEEC0zGifnSlQx7Rf9qA3KeCWt65b0IE-DQhsPfkMKX2WRaB4-FZGW6zegRPtE2YmT8q7sVC-q7X-HPLPrHuma5akez-WLjXd5AUe0dBslMjfDQQOa8Qn1eaGyLE-sBooWfgWkLVe4pytljc9YPQpQaLSmjvaHFGvPBMroCmAgBqFU_tjaM6NeGqFSKgE2JYTa3BCIAUaN1g9dmn4Lr38WXkikkHfMlArrwJq3LLpVuZV0dPKh1PtAE"/>
</div>
<div class="space-y-1">
