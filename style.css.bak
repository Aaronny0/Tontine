<span class="text-sm font-semibold">Montant</span>
<span class="material-symbols-outlined text-outline" data-icon="expand_more">expand_more</span>
</div>
<div class="bg-surface-container-high px-4 py-2 rounded-full flex items-center gap-2 cursor-pointer hover:bg-surface-container-highest transition-colors">
<span class="material-symbols-outlined text-primary text-xl" data-icon="event_repeat">event_repeat</span>
<span class="text-sm font-semibold">Fréquence</span>
<span class="material-symbols-outlined text-outline" data-icon="expand_more">expand_more</span>
</div>
<div class="bg-surface-container-high px-4 py-2 rounded-full flex items-center gap-2 cursor-pointer hover:bg-surface-container-highest transition-colors">
<span class="material-symbols-outlined text-primary text-xl" data-icon="verified_user">verified_user</span>
<span class="text-sm font-semibold">Score de confiance</span>
<span class="material-symbols-outlined text-outline" data-icon="expand_more">expand_more</span>
</div>
<div class="h-6 w-px bg-outline-variant mx-2 hidden md:block"></div>
<button class="text-primary font-bold text-sm flex items-center gap-1">
<span>Effacer tout</span>
</button>
</section>
<!-- Section Title -->
<div class="flex justify-between items-end mb-8">
<div>
<h2 class="font-headline font-bold text-2xl text-primary">Appels à tontines</h2>
<p class="text-outline text-sm mt-1">Opportunités d'épargne collective disponibles</p>
</div>
<div class="flex gap-2">
<button class="w-10 h-10 rounded-full border border-outline-variant flex items-center justify-center text-primary hover:bg-surface-container transition-colors">
<span class="material-symbols-outlined" data-icon="grid_view">grid_view</span>
</button>
<button class="w-10 h-10 rounded-full border border-outline-variant flex items-center justify-center text-outline hover:bg-surface-container transition-colors">
<span class="material-symbols-outlined" data-icon="format_list_bulleted">format_list_bulleted</span>
</button>
</div>
</div>
<!-- Tontine Cards Grid -->
<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
<!-- Card 1 (Verified High Score) -->
<div class="bg-surface-container-lowest rounded-[2rem] overflow-hidden group hover:translate-y-[-4px] transition-all duration-300 shadow-sm hover:shadow-xl relative border-t-4 border-secondary">
<div class="p-6">
<div class="flex justify-between items-start mb-6">
<div class="bg-secondary-container/20 text-secondary-container px-3 py-1 rounded-full flex items-center gap-1.5 border border-secondary-container/30">
<span class="material-symbols-outlined text-sm" data-icon="verified" style="font-variation-settings: 'FILL' 1;">verified</span>
<span class="text-[10px] font-bold uppercase tracking-wider">Vérifié</span>
</div>
<div class="flex items-center gap-1 text-primary font-bold text-lg">
<span class="material-symbols-outlined text-secondary" data-icon="star" style="font-variation-settings: 'FILL' 1;">star</span>
<span>4.9</span>
</div>
</div>
<h3 class="font-headline font-extrabold text-xl mb-2 text-primary">Les Bâtisseurs de Cotonou</h3>
<p class="text-outline text-sm mb-6 line-clamp-2">Groupe d'entrepreneurs locaux dédié à l'investissement immobilier et commercial.</p>
<div class="grid grid-cols-2 gap-4 mb-8">
<div class="bg-surface-container-low p-4 rounded-2xl">
<span class="text-[10px] text-outline uppercase font-bold tracking-widest block mb-1">Cotisation</span>
<span class="text-primary font-bold text-lg">50.000 FCFA</span>
</div>
<div class="bg-surface-container-low p-4 rounded-2xl">
<span class="text-[10px] text-outline uppercase font-bold tracking-widest block mb-1">Cycle</span>
<span class="text-primary font-bold text-lg">Mensuel</span>
</div>
</div>
<div class="flex items-center justify-between mb-8">
<div class="flex -space-x-3">
<img class="w-8 h-8 rounded-full border-2 border-white object-cover" data-alt="Portrait of a young man smiling softly" src="https://lh3.googleusercontent.com/aida-public/AB6AXuA30zKqH3qVTYTJqoUN4AIO4bhyBK_MXC2a-ff3bW4oq4w0zhdlTHWRtwOKyVsbM7N8NLCuuTST1VObKHYB7nce0OV-yE6vvohY5ugK1WQA9lNg-LXkbGK0w2PenJ2ODR8AHZ-2ssdTDUE5HO4eDzK_RKqODXFj0p6Js9R_oGSmdBaSaweGPoQVKgvE2Lqz4x_rr5OiGOdZN1TJ2w_8zivfNH7xn-5QnoVyroHrGkHEkBqg4U3FJIhcVg4QsUNMZPWSKX9qKE-8vSM"/>
<img class="w-8 h-8 rounded-full border-2 border-white object-cover" data-alt="Portrait of a woman with braided hair smiling" src="https://lh3.googleusercontent.com/aida-public/AB6AXuAULv5RLNbKgGnzsy5sC_CXnRj2-6n7O2LDY2Ba84aYhB3VA2037QeLmqjNISX3J5UmF0wsucSUGOPboIgoEoBQSQEEy9hsIpN4NnEc0w25j4XdvCuI9bUFmRHPiRomttuJ5zeYHSTmXcXaYHtyfQPdzbNGAeHDxuDB-5INDIPwVTvrb9Fy9j3LWDVYlc51c7Filv1kSoMjFixOhT7Cq5x6bWzFeum3ADw_ISrnc7ziPUTYUgA1QpKWisYBaZ0ZjqL6oOOpUIK9keU"/>
<img class="w-8 h-8 rounded-full border-2 border-white object-cover" data-alt="Portrait of a distinguished older man in a suit" src="https://lh3.googleusercontent.com/aida-public/AB6AXuCIF-YgVXTryd50KvfehO639eSFQ9ETldaZAFAy98vZ4tKefuvoZMZlIMAOPYfiCQ0NMDNOf-2Kw0nlojA9TE44CcGFq186zt_bw72ek8VFGBsk80GLXq7KRx2wVkDRbr8EFO0z1bZjaLnkA65QLhK9Q-Czn-_ik8f_QBQoPClh8rtRqtiqT6nrUeqUiAqTCMWWATqiVm4-d2RCun4eeAtfq_LP_IIhMrvsVinSR-Y0nHOyoNThSXMSSdJ3Y8u8NWBbrxaoI_vqCsE"/>
<div class="w-8 h-8 rounded-full border-2 border-white bg-primary-fixed flex items-center justify-center text-[10px] font-bold text-primary">+8</div>
</div>
<span class="text-xs font-bold text-outline">11 / 15 membres</span>
</div>
<div class="flex items-center justify-between gap-4">
<div class="text-xs">
<span class="block text-outline">Début le</span>
<span class="font-bold text-primary">15 Octobre</span>
</div>
<button class="bg-primary text-on-primary font-bold px-6 py-3 rounded-xl flex-grow hover:bg-primary-container transition-colors shadow-lg shadow-primary/10">
                            Rejoindre
                        </button>
</div>
</div>
</div>
<!-- Card 2 -->
<div class="bg-surface-container-lowest rounded-[2rem] overflow-hidden group hover:translate-y-[-4px] transition-all duration-300 shadow-sm hover:shadow-xl relative border-t-4 border-primary-fixed">
<div class="p-6">
<div class="flex justify-between items-start mb-6">
<div class="bg-primary-fixed/30 text-primary px-3 py-1 rounded-full flex items-center gap-1.5 border border-primary-fixed/50">
<span class="material-symbols-outlined text-sm" data-icon="schedule">schedule</span>
<span class="text-[10px] font-bold uppercase tracking-wider">Bientôt Prêt</span>
</div>
<div class="flex items-center gap-1 text-primary font-bold text-lg">
<span class="material-symbols-outlined text-secondary" data-icon="star" style="font-variation-settings: 'FILL' 1;">star</span>
<span>4.2</span>
</div>
</div>
<h3 class="font-headline font-extrabold text-xl mb-2 text-primary">Solidarité Éducation</h3>
<p class="text-outline text-sm mb-6 line-clamp-2">Épargne mutuelle pour le financement des frais de scolarité universitaire.</p>
<div class="grid grid-cols-2 gap-4 mb-8">
<div class="bg-surface-container-low p-4 rounded-2xl">
<span class="text-[10px] text-outline uppercase font-bold tracking-widest block mb-1">Cotisation</span>
<span class="text-primary font-bold text-lg">25.000 FCFA</span>
</div>
<div class="bg-surface-container-low p-4 rounded-2xl">
<span class="text-[10px] text-outline uppercase font-bold tracking-widest block mb-1">Cycle</span>
<span class="text-primary font-bold text-lg">Hebdo</span>
</div>
</div>
