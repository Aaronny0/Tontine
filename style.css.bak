</div>
</div>
</main>
<!-- Bottom Navigation Shell -->
<nav class="fixed bottom-0 left-0 w-full flex justify-around items-center px-4 pt-3 pb-8 bg-[#FDFBF7]/80 dark:bg-[#001A13]/80 backdrop-blur-xl z-50 rounded-t-[24px] shadow-[0_-8px_30px_rgb(0,53,39,0.06)]">
