</div>
</div>
<!-- Golden accent border -->
<div class="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-secondary-container to-secondary"></div>
</div>
</div>
</div>
<!-- System Message: Reminder -->
<div class="flex justify-center px-4">
