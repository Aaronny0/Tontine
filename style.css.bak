<img class="w-full h-full object-cover" data-alt="Headshot of an African businessman in a suit looking professional with a soft warm lighting background" src="https://lh3.googleusercontent.com/aida-public/AB6AXuDcpkdES4Fh4CkIuEUcxK8H5eBAM5LRQ9G9zCcsk9c24USzOCZrS2AmaV58lHjuNjkgtZI9HRMUBxmqhvQ5vc4atMbJS3n0-sNow94DiRWPAazciNW9kLX9vqhhibnpcnHw3rzt1CFaXFGamba8z9iEbE8FsSIsoHsRXC4aaugkm3jI5OT5h8fdWXaHuOQycmaz7U48TN3_1Y5SL-z2fsMYvdf4WTEdlT3FnPfbs8N6ObtzGu8kKcCFBf8fYQ6Gr5vbrzl46DyC5IA"/>
</div>
<div class="space-y-1">
<p class="text-[11px] font-bold text-primary px-1">Moussa T.</p>
<div class="bg-surface-container-lowest p-4 rounded-2xl rounded-tl-none shadow-[0_4px_15px_rgba(0,53,39,0.03)] border-l-2 border-primary/10">
