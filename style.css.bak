</button>
</div>
</header>
<main class="px-6 pt-6 max-w-5xl mx-auto space-y-8">
<!-- Hero Header Section -->
<section class="relative overflow-hidden bg-primary rounded-[2rem] p-8 text-on-primary shadow-xl">
<div class="absolute inset-0 pattern-overlay opacity-20"></div>
<div class="relative z-10 flex flex-col md:flex-row justify-between items-start md:items-center gap-6">
<div>
<span class="text-on-primary-container bg-primary-container/30 px-3 py-1 rounded-full text-xs font-bold tracking-widest uppercase mb-4 inline-block">Patrimoine Actif</span>
<h1 class="text-4xl font-extrabold mb-2 tracking-tight">Cercle des Entrepreneurs</h1>
<p class="text-on-primary-container font-medium">Créé par Amadou Diop • 12 Membres</p>
</div>
<div class="text-right">
<p class="text-secondary-fixed text-sm font-semibold mb-1">Montant Total de la Tontine</p>
<div class="text-5xl font-black tracking-tighter text-secondary-container">
                        5.000.000 <span class="text-xl font-bold uppercase">CFA</span>
</div>
</div>
</div>
</section><div class="grid grid-cols-2 gap-4 mt-6">
