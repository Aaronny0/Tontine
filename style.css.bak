<div class="w-24 h-2 bg-surface-container-high rounded-full mt-1 overflow-hidden">
<div class="h-full bg-secondary-container w-[85%]"></div>
</div>
</div>
</div>
</div>
<!-- Timeline Item: Future (Me) -->
<div class="relative flex items-center gap-6">
