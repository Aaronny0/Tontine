<!DOCTYPE html>

<html class="light" lang="fr"><head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1.0" name="viewport"/>
<title>Onboarding - TontineChain</title>
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;700;800&amp;family=Plus_Jakarta_Sans:wght@400;500;600;700&amp;display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
<script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    "colors": {
                        "outline-variant": "#bfc9c3",
                        "tertiary-container": "#5a4000",
                        "on-tertiary": "#ffffff",
                        "surface-variant": "#e4e2de",
                        "tertiary-fixed": "#ffdea4",
                        "on-error": "#ffffff",
                        "tertiary-fixed-dim": "#f0bf5d",
                        "surface-container-highest": "#e4e2de",
                        "on-background": "#1b1c1a",
                        "surface-container": "#efeeea",
                        "inverse-on-surface": "#f2f0ed",
                        "surface-container-high": "#eae8e4",
                        "on-secondary": "#ffffff",
                        "on-primary-fixed-variant": "#0b513d",
                        "on-surface": "#1b1c1a",
                        "surface": "#fbf9f5",
                        "secondary-fixed-dim": "#e9c349",
                        "primary": "#003527",
                        "secondary": "#735c00",
                        "on-error-container": "#93000a",
                        "primary-container": "#064e3b",
                        "secondary-container": "#fed65b",
                        "secondary-fixed": "#ffe088",
                        "on-tertiary-fixed-variant": "#5d4200",
                        "background": "#fbf9f5",
                        "primary-fixed": "#b0f0d6",
                        "surface-dim": "#dbdad6",
                        "surface-container-lowest": "#ffffff",
                        "on-secondary-fixed": "#241a00",
                        "primary-fixed-dim": "#95d3ba",
                        "on-tertiary-fixed": "#261900",
                        "on-tertiary-container": "#daab4b",
                        "on-primary": "#ffffff",
                        "error": "#ba1a1a",
                        "on-surface-variant": "#404944",
                        "on-primary-container": "#80bea6",
                        "outline": "#707974",
                        "surface-container-low": "#f5f3ef",
                        "surface-tint": "#2b6954",
                        "tertiary": "#3e2b00",
                        "inverse-surface": "#30312e",
                        "error-container": "#ffdad6",
                        "inverse-primary": "#95d3ba",
                        "on-secondary-fixed-variant": "#574500",
                        "on-secondary-container": "#745c00",
                        "surface-bright": "#fbf9f5",
                        "on-primary-fixed": "#002117"
                    },
                    "borderRadius": {
                        "DEFAULT": "0.25rem",
                        "lg": "0.5rem",
                        "xl": "1.5rem",
                        "full": "9999px"
                    },
                    "fontFamily": {
                        "headline": ["Manrope"],
                        "body": ["Plus Jakarta Sans"],
                        "label": ["Plus Jakarta Sans"]
                    }
                }
            }
        }
    </script>
<style>
        .textile-pattern {
            background-image: radial-gradient(rgba(0, 53, 39, 0.05) 1px, transparent 1px);
            background-size: 24px 24px;
        }
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }
    </style>
<style>
    body {
      min-height: max(884px, 100dvh);
    }
  </style>
</head>
<body class="bg-background font-body text-on-background selection:bg-primary-fixed selection:text-on-primary-fixed overflow-x-hidden">
<!-- Suppression de TopAppBar et BottomNavBar pour l'onboarding selon la règle "Destination Rule" -->
<main class="min-h-screen flex flex-col relative textile-pattern">
<!-- Header / Logo Area -->
<header class="w-full px-6 py-10 flex flex-col items-center justify-center space-y-4">
<div class="relative group">
<div class="rounded-full flex items-center justify-center shadow-xl transform transition-transform group-hover:scale-105 w-24 h-24">
<!-- Custom Logo Concept: Interlocking links in a circle -->
<img alt="TontineChain Logo" class="object-contain relative z-10 w-16 h-16" src="https://lh3.googleusercontent.com/aida/ADBb0ug2vKZ0Q9uvQXXAkE7Fj89jwh2U38FTenZLpjZ2bvJ4dhY60ErFH4jnI3lix3nwfqNjorFukQ51SHFnc-EIoULgZoA28P8dDSQNoD7QOd-6gdlRzEN9gwuOvx-UhK7jHKiPObgb5ENU4_zjVPf0J-jFh_-JloyedJIFrog_xkC6Ac5FVlsFSCeFkYoFnorHKSqPzJKwBuj2vgWyUgXf5bfmhbiXxn1vCy0h1F7yyJTqq9zPbum9pny-3_YFnvoYs9cqQ4erCsDgpA"/>
</div>
</div>
<div class="text-center">
<h1 class="font-headline font-extrabold text-4xl tracking-tight text-primary">
                    TontineChain
                </h1>
<p class="font-medium text-primary/60 tracking-[0.2em] uppercase text-[10px] mt-1">
                    Patrimoine &amp; Confiance
                </p>
</div>
</header>
<!-- Hero Content -->
<section class="flex-grow flex flex-col px-6 md:px-12 max-w-5xl mx-auto w-full">
<div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center py-12">
<!-- Visual Pillar -->
<div class="order-2 md:order-1 relative">
<div class="relative rounded-[2.5rem] overflow-hidden aspect-[4/5] shadow-2xl">
<img alt="Fintech Heritage" class="w-full h-full object-cover" data-alt="Premium close-up of a digital tablet showing financial growth charts with gold accents in a luxury dark green setting with soft morning light" src="https://lh3.googleusercontent.com/aida-public/AB6AXuAszrdwQuGIqNRDYRnHuaTtnZIuLohDmwfzF8M9jB0cevfQhVZuGoSrs3Jt2nVzBASXwtZjLGpspRVGa8mgnbpIepZvJUMesbxb2vHgVbdyCtfBkkVwTP4nOrMB6RPKPosvMrJMez12eJlCk9ENtOD_9zxo03fGoLxhVoe7w-cZ6B4Wds5ntmAQjMpef_yQwoA-eO6t12RmZj1OdGVZgEUwRUwl082K4ZDbPIR25UuBHAP2uQBDuzyOtJRTbjkpTW35eeiXCyqMUOY"/>
<div class="absolute inset-0 bg-gradient-to-t from-primary/80 via-transparent to-transparent"></div>
<!-- Floating Glass Card -->
<div class="absolute bottom-6 left-6 right-6 p-6 bg-surface/80 backdrop-blur-md rounded-xl shadow-lg border border-white/20">
<div class="flex items-center space-x-4 mb-3">
<div class="p-2 bg-primary/10 rounded-lg">
<span class="material-symbols-outlined text-primary" data-icon="verified">verified</span>
</div>
<span class="font-bold text-primary text-sm">Garantie Blockchain</span>
</div>
<p class="text-xs text-on-surface-variant leading-relaxed">
                                Chaque transaction est immuable, garantissant l'intégrité de votre épargne collective.
                            </p>
</div>
</div>
<!-- Decorative Elements -->
<div class="absolute -top-4 -right-4 w-24 h-24 bg-secondary-container rounded-full mix-blend-multiply opacity-20 blur-xl"></div>
<div class="absolute -bottom-10 -left-10 w-40 h-40 bg-primary-fixed-dim rounded-full mix-blend-multiply opacity-10 blur-2xl"></div>
</div>
<!-- Text Pillar -->
<div class="order-1 md:order-2 space-y-8">
<div class="space-y-4">
<span class="inline-block px-4 py-1 rounded-full bg-secondary-container/20 text-on-secondary-container text-xs font-bold uppercase tracking-wider">
                            Nouvelle Ère Financière
                        </span>
<h2 class="font-headline font-extrabold text-5xl md:text-6xl text-primary leading-[1.1]">
                            L'épargne <span class="text-tertiary-fixed-dim">collective</span>, réinventée.
                        </h2>
<p class="text-lg text-on-surface-variant leading-relaxed font-medium">
                            Rejoignez des cercles de solidarité numériques. Épargnez ensemble, réalisez vos projets et sécurisez votre avenir grâce à la puissance de la blockchain.
                        </p>
</div>
<div class="grid grid-cols-1 gap-4">
<!-- Stat Card Bento Item -->
<div class="p-6 bg-surface-container-lowest rounded-xl shadow-sm border-t-4 border-tertiary-fixed-dim">
<div class="flex items-center space-x-4">
<span class="material-symbols-outlined text-3xl text-primary" data-icon="groups">groups</span>
<div>
<h4 class="font-bold text-primary">Communauté Active</h4>
<p class="text-sm text-on-surface-variant">Plus de 50,000 membres partagent déjà leur succès.</p>
</div>
</div>
</div>
</div>
<!-- CTA Actions -->
<div class="flex flex-col sm:flex-row gap-4 pt-4">
<button class="flex-1 px-8 py-5 bg-primary text-on-primary rounded-xl font-bold text-lg hover:opacity-90 transition-all flex items-center justify-center space-x-3 shadow-lg shadow-primary/20">
<span>Commencer</span>
<span class="material-symbols-outlined" data-icon="arrow_forward">arrow_forward</span>
</button>
<button class="flex-1 px-8 py-5 bg-transparent border-2 border-outline-variant text-primary rounded-xl font-bold text-lg hover:bg-surface-container transition-all flex items-center justify-center">
<span>Se connecter</span>
</button>
</div>
</div>
</div>
</section>
<!-- Footer / Trust Elements -->
<footer class="w-full px-6 py-12 mt-auto">
<div class="max-w-5xl mx-auto flex flex-col md:flex-row justify-between items-center gap-8 opacity-60">
<div class="flex items-center space-x-8">
<div class="flex items-center space-x-2">
<span class="material-symbols-outlined text-xl" data-icon="security">security</span>
<span class="text-xs font-semibold">Cryptage AES-256</span>
</div>
<div class="flex items-center space-x-2">
<span class="material-symbols-outlined text-xl" data-icon="account_balance">account_balance</span>
<span class="text-xs font-semibold">Régulé &amp; Conforme</span>
</div>
</div>
<div class="text-[10px] uppercase tracking-widest font-bold">
                    © 2024 TontineChain — L'Héritage Moderne
                </div>
</div>
</footer>
</main>
</body></html>
-------------------------------------------------------------------------------------------------------------------------------
<!DOCTYPE html>

<html class="light" lang="fr"><head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1.0" name="viewport"/>
<title>TontineChain - Tableau de Bord</title>
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;700;800&amp;family=Plus_Jakarta_Sans:wght@400;500;600;700&amp;display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
<script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    "colors": {
                        "outline-variant": "#bfc9c3",
                        "tertiary-container": "#5a4000",
                        "on-tertiary": "#ffffff",
                        "surface-variant": "#e4e2de",
                        "tertiary-fixed": "#ffdea4",
                        "on-error": "#ffffff",
                        "tertiary-fixed-dim": "#f0bf5d",
                        "surface-container-highest": "#e4e2de",
                        "on-background": "#1b1c1a",
                        "surface-container": "#efeeea",
                        "inverse-on-surface": "#f2f0ed",
                        "surface-container-high": "#eae8e4",
                        "on-secondary": "#ffffff",
                        "on-primary-fixed-variant": "#0b513d",
                        "on-surface": "#1b1c1a",
                        "surface": "#fbf9f5",
                        "secondary-fixed-dim": "#e9c349",
                        "primary": "#003527",
                        "secondary": "#735c00",
                        "on-error-container": "#93000a",
                        "primary-container": "#064e3b",
                        "secondary-container": "#fed65b",
                        "secondary-fixed": "#ffe088",
                        "on-tertiary-fixed-variant": "#5d4200",
                        "background": "#fbf9f5",
                        "primary-fixed": "#b0f0d6",
                        "surface-dim": "#dbdad6",
                        "surface-container-lowest": "#ffffff",
                        "on-secondary-fixed": "#241a00",
                        "primary-fixed-dim": "#95d3ba",
                        "on-tertiary-fixed": "#261900",
                        "on-tertiary-container": "#daab4b",
                        "on-primary": "#ffffff",
                        "error": "#ba1a1a",
                        "on-surface-variant": "#404944",
                        "on-primary-container": "#80bea6",
                        "outline": "#707974",
                        "surface-container-low": "#f5f3ef",
                        "surface-tint": "#2b6954",
                        "tertiary": "#3e2b00",
                        "inverse-surface": "#30312e",
                        "error-container": "#ffdad6",
                        "inverse-primary": "#95d3ba",
                        "on-secondary-fixed-variant": "#574500",
                        "on-secondary-container": "#745c00",
                        "surface-bright": "#fbf9f5",
                        "on-primary-fixed": "#002117"
                    },
                    "borderRadius": {
                        "DEFAULT": "0.25rem",
                        "lg": "0.5rem",
                        "xl": "0.75rem",
                        "2xl": "1rem",
                        "3xl": "1.5rem",
                        "full": "9999px"
                    },
                    "fontFamily": {
                        "headline": ["Manrope"],
                        "body": ["Plus Jakarta Sans"],
                        "label": ["Plus Jakarta Sans"]
                    }
                }
            }
        }
    </script>
<style>
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
            vertical-align: middle;
        }
        body { font-family: 'Plus Jakarta Sans', sans-serif; }
        h1, h2, h3 { font-family: 'Manrope', sans-serif; }
        .textile-pattern {
            background-image: radial-gradient(circle at 2px 2px, rgba(0,53,39,0.05) 1px, transparent 0);
            background-size: 16px 16px;
        }
    </style>
<style>
    body {
      min-height: max(884px, 100dvh);
    }
  </style>
  </head>
<body class="bg-background text-on-background min-h-screen pb-24 textile-pattern">
<!-- TopAppBar -->
<header class="bg-[#FDFBF7] dark:bg-[#001A13] flex justify-between items-center px-6 py-4 w-full z-50 backdrop-blur-md sticky top-0">
<div class="flex items-center gap-3">
<div class="w-10 h-10 rounded-full bg-primary-container flex items-center justify-center overflow-hidden">
<img alt="Photo de profil" data-alt="Portrait of a professional West African man in a clean modern office, warm lighting, blurred background" src="https://lh3.googleusercontent.com/aida-public/AB6AXuCSVfN-eH9Sr-dTNEGNlEk_fIo8dFOZkkDZby6uw5fPuE71im_IGpaQzHoM9oCKILUcwULiqez2bWrsN6vhpg2If46C-6Lkt8B8Ex9o7sGxJqGiCzcWAQFhUqNGiHYqjY0KXMgt88gVy7iNTq2881OGwpc4M8fvTeRzn-dOmrHgD-qKkUKAbSlrvXOepp07alLYb1xM-4Tfida4T_0JzEXB4gyMl1QePTXz2CHZ30a7yuBsdmnUff2IM4MJlBYyqM2IUHQeg8NDzfs"/>
</div>
<span class="text-[#003527] dark:text-[#D4AF37] text-2xl font-black">TontineChain</span>
</div>
<div class="flex items-center gap-4">
<button class="text-[#064E3B] dark:text-[#E8F5E9] hover:opacity-80 transition-opacity">
<span class="material-symbols-outlined" data-icon="notifications">notifications</span>
</button>
</div>
</header>
<main class="max-w-5xl mx-auto px-6 py-8">
<!-- Salutation Section -->
<section class="mb-10">
<p class="text-on-surface-variant font-medium text-sm tracking-wide mb-1">BIENVENUE DANS VOTRE PATRIMOINE</p>
<h1 class="text-4xl font-extrabold text-primary leading-tight">Bonjour, Amadou !</h1>
</section>
<div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
<!-- Bento Column Left: Financial Summary & Active Circles -->
<div class="lg:col-span-8 space-y-8">
<!-- Premium Financial Card -->
<div class="bg-primary rounded-3xl p-8 relative overflow-hidden shadow-2xl">
<!-- Texture Overlay -->
<div class="absolute inset-0 opacity-10 pointer-events-none" style="background-image: linear-gradient(30deg, #D4AF37 12%, transparent 12.5%, transparent 87%, #D4AF37 87.5%, #D4AF37), linear-gradient(150deg, #D4AF37 12%, transparent 12.5%, transparent 87%, #D4AF37 87.5%, #D4AF37), linear-gradient(30deg, #D4AF37 12%, transparent 12.5%, transparent 87%, #D4AF37 87.5%, #D4AF37), linear-gradient(150deg, #D4AF37 12%, transparent 12.5%, transparent 87%, #D4AF37 87.5%, #D4AF37), linear-gradient(60deg, #D4AF37 25%, transparent 25.5%, transparent 75%, #D4AF37 75.5%, #D4AF37), linear-gradient(60deg, #D4AF37 25%, transparent 25.5%, transparent 75%, #D4AF37 75.5%, #D4AF37); background-size: 40px 70px;"></div>
<div class="relative z-10">
<div class="flex justify-between items-start mb-12">
<div>
<p class="text-primary-fixed-dim/70 text-sm font-semibold uppercase tracking-widest">Patrimoine Total</p>
<h2 class="text-5xl font-extrabold text-white mt-2">2 450 000 <span class="text-2xl font-light text-primary-fixed-dim">FCFA</span></h2>
</div>
<div class="bg-secondary-container text-on-secondary-container px-4 py-2 rounded-xl flex items-center gap-2">
<span class="material-symbols-outlined text-sm" data-icon="verified_user" style="font-variation-settings: 'FILL' 1;">verified_user</span>
<span class="text-xs font-bold uppercase tracking-tighter">Sécurisé par Blockchain</span>
</div>
</div>
<div class="grid grid-cols-2 gap-6 pt-8 border-t border-white/10">
<div class="space-y-1">
<p class="text-primary-fixed-dim/60 text-xs font-medium">Total épargné</p>
<p class="text-xl font-bold text-white tracking-tight">1 800 000 FCFA</p>
</div>
<div class="space-y-1 text-right">
<p class="text-primary-fixed-dim/60 text-xs font-medium">Total reçu</p>
<p class="text-xl font-bold text-white tracking-tight">650 000 FCFA</p>
</div>
</div>
</div>
</div>
<!-- Active Tontines List -->
<div class="space-y-6">
<div class="flex justify-between items-end">
<h3 class="text-2xl font-bold text-primary">Tontines Actives</h3>
<p class="text-sm font-medium text-primary-fixed-dim bg-primary px-3 py-1 rounded-full">3 cercles en cours</p>
</div>
<div class="space-y-4">
<!-- Tontine Item 1 -->
<div class="bg-surface-container-lowest p-5 rounded-2xl flex items-center justify-between group transition-all hover:bg-white hover:shadow-xl hover:shadow-primary/5">
<div class="flex items-center gap-4">
<div class="w-12 h-12 bg-surface-container rounded-xl flex items-center justify-center text-primary">
<span class="material-symbols-outlined" data-icon="groups">groups</span>
</div>
<div>
<h4 class="font-bold text-on-surface">Cercle "Les Entrepreneurs"</h4>
<p class="text-xs text-on-surface-variant font-medium">Cotisation : 50 000 FCFA / mois</p>
</div>
</div>
<div class="flex flex-col items-end gap-2">
<span class="px-3 py-1 bg-primary-fixed text-on-primary-fixed-variant text-[10px] font-bold rounded-full uppercase tracking-widest">En règle</span>
<p class="text-xs font-semibold text-primary">12 / 15 participants</p>
</div>
</div>
<!-- Tontine Item 2 -->
<div class="bg-surface-container-lowest p-5 rounded-2xl flex items-center justify-between group transition-all hover:bg-white hover:shadow-xl hover:shadow-primary/5">
<div class="flex items-center gap-4">
<div class="w-12 h-12 bg-surface-container rounded-xl flex items-center justify-center text-primary">
<span class="material-symbols-outlined" data-icon="home">home</span>
</div>
<div>
<h4 class="font-bold text-on-surface">Fond Immobilier Familial</h4>
<p class="text-xs text-on-surface-variant font-medium">Cotisation : 200 000 FCFA / trimestre</p>
</div>
</div>
<div class="flex flex-col items-end gap-2">
<span class="px-3 py-1 bg-secondary-fixed text-on-secondary-fixed-variant text-[10px] font-bold rounded-full uppercase tracking-widest">Collecte</span>
<p class="text-xs font-semibold text-primary">8 / 8 participants</p>
</div>
</div>
</div>
</div>
</div>
<!-- Bento Column Right: Focus Actions -->
<div class="lg:col-span-4 space-y-8">
<!-- Highlight Card: Your Next Turn -->
<div class="bg-surface-container-high rounded-3xl p-8 relative border-t-4 border-secondary overflow-hidden">
<h3 class="text-lg font-extrabold text-primary mb-8">Votre prochain tour</h3>
<div class="flex flex-col items-center text-center space-y-6">
<!-- Progression Circle Mockup -->
<div class="relative w-40 h-40 flex items-center justify-center">
<svg class="w-full h-full -rotate-90">
<circle class="text-surface-container" cx="80" cy="80" fill="transparent" r="70" stroke="currentColor" stroke-width="12"></circle>
<circle class="text-secondary" cx="80" cy="80" fill="transparent" r="70" stroke="currentColor" stroke-dasharray="440" stroke-dashoffset="110" stroke-width="12"></circle>
</svg>
<div class="absolute flex flex-col items-center">
<span class="text-xs font-bold text-on-surface-variant uppercase">Dans</span>
<span class="text-3xl font-black text-primary">12</span>
<span class="text-xs font-bold text-on-surface-variant uppercase">Jours</span>
</div>
</div>
<div class="space-y-1">
<p class="text-sm font-medium text-on-surface-variant">Date de réception prévue</p>
<p class="text-xl font-extrabold text-primary">15 Juillet 2024</p>
</div>
<div class="bg-primary/5 rounded-2xl p-4 w-full">
<p class="text-xs font-bold text-primary/60 uppercase mb-1">Montant à recevoir</p>
<p class="text-2xl font-black text-secondary">600 000 FCFA</p>
</div>
</div>
</div>
<!-- Call to Action -->
<div class="bg-white rounded-3xl p-6 shadow-xl shadow-primary/5 flex flex-col gap-4">
<button class="w-full py-4 bg-primary text-on-primary rounded-xl font-bold flex items-center justify-center gap-2 hover:opacity-90 transition-opacity">
<span class="material-symbols-outlined" data-icon="add_circle">add_circle</span>
                        Rejoindre un nouveau cercle
                    </button>
<button class="w-full py-4 border border-outline-variant text-primary rounded-xl font-bold flex items-center justify-center gap-2 hover:bg-surface-container-low transition-colors">
<span class="material-symbols-outlined" data-icon="history_edu">history_edu</span>
                        Voir mes contrats
                    </button>
</div>
</div>
</div>
</main>
<!-- BottomNavBar -->
<nav class="fixed bottom-0 left-0 w-full flex justify-around items-center px-4 pt-3 pb-8 backdrop-blur-xl bg-[#FDFBF7]/80 dark:bg-[#001A13]/80 z-50 border-t-0 rounded-t-[24px] shadow-[0_-8px_30px_rgb(0,53,39,0.06)]">
<a class="flex flex-col items-center justify-center text-[#064E3B] dark:text-[#D4AF37] font-bold" href="#">
<span class="material-symbols-outlined" data-icon="dashboard" style="font-variation-settings: 'FILL' 1;">dashboard</span>
<span class="font-['Plus_Jakarta_Sans'] font-medium text-[10px] mt-1">Accueil</span>
</a>
<a class="flex flex-col items-center justify-center text-[#064E3B]/40 dark:text-white/30 hover:text-[#D4AF37] transition-colors" href="#">
<span class="material-symbols-outlined" data-icon="explore">explore</span>
<span class="font-['Plus_Jakarta_Sans'] font-medium text-[10px] mt-1">Explorer</span>
</a>
<a class="flex flex-col items-center justify-center text-[#064E3B]/40 dark:text-white/30 hover:text-[#D4AF37] transition-colors" href="#">
<span class="material-symbols-outlined text-4xl" data-icon="add_circle">add_circle</span>
<span class="font-['Plus_Jakarta_Sans'] font-medium text-[10px] mt-1">Créer</span>
</a>
<a class="flex flex-col items-center justify-center text-[#064E3B]/40 dark:text-white/30 hover:text-[#D4AF37] transition-colors" href="#">
<span class="material-symbols-outlined" data-icon="history_edu">history_edu</span>
<span class="font-['Plus_Jakarta_Sans'] font-medium text-[10px] mt-1">Contrats</span>
</a>
<a class="flex flex-col items-center justify-center text-[#064E3B]/40 dark:text-white/30 hover:text-[#D4AF37] transition-colors" href="#">
<span class="material-symbols-outlined" data-icon="person">person</span>
<span class="font-['Plus_Jakarta_Sans'] font-medium text-[10px] mt-1">Profil</span>
</a>
</nav>
</body></html>
