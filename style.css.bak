<body class="bg-background text-on-background font-body min-h-screen pb-32 overflow-x-hidden">
<!-- TopAppBar -->
<header class="bg-[#FDFBF7] dark:bg-[#001A13] flex justify-between items-center px-6 py-4 w-full z-50 backdrop-blur-md sticky top-0">
<div class="flex items-center gap-3">
<img alt="Photo de profil de l'utilisateur" class="w-10 h-10 rounded-full border-2 border-primary-container" data-alt="close-up portrait of a professional African man with a friendly expression and stylish short hair" src="https://lh3.googleusercontent.com/aida-public/AB6AXuCIntpi4j4PhTUPxvgHx59aOWRFWqbe2SAmTReWz81SrWcO6Q_CGxkTrhl_N4f_MZIin_OkWjTS3SJb7z7P35So6AcQ9owANzHoGp1LzLlCNe1zaEQCRfU2DLacrfj6NTcr-XtZHI_K7GaDWeN3NaYu_6Sf2F5UHAe8ZCfab2p5wL5rJCgTeE1MUcNooZ48OgafLyRlRuZePSFf_hSwPUFLOKChckROd8ajLl6Qsx6SF6dzOFibW1eV1fvnX3T9f3Tnliy4DSbKxRM"/>
