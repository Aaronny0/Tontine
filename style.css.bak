<span>Contrats</span>
</div>
<div class="flex flex-col items-center justify-center text-[#064E3B]/40 font-medium text-[10px]">
<span class="material-symbols-outlined" data-icon="explore">explore</span>
<span>Explorer</span>
</div>
<div class="flex flex-col items-center justify-center text-[#064E3B]/40 font-medium text-[10px]">
<span class="material-symbols-outlined" data-icon="person">person</span>
<span>Profil</span>
</div>
</nav>
</body></html>
