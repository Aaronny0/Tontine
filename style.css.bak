<!DOCTYPE html>

<html class="light" lang="fr"><head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1.0" name="viewport"/>
<link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;700;800&amp;family=Plus+Jakarta+Sans:wght@400;500;600;700&amp;display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<script id="tailwind-config">
      tailwind.config = {
        darkMode: "class",
        theme: {
          extend: {
            "colors": {
                    "outline-variant": "#bfc9c3",
                    "tertiary-container": "#5a4000",
                    "on-tertiary": "#ffffff",
                    "surface-variant": "#e4e2de",
                    "tertiary-fixed": "#ffdea4",
                    "on-error": "#ffffff",
                    "tertiary-fixed-dim": "#f0bf5d",
                    "surface-container-highest": "#e4e2de",
                    "on-background": "#1b1c1a",
                    "surface-container": "#efeeea",
                    "inverse-on-surface": "#f2f0ed",
                    "surface-container-high": "#eae8e4",
                    "on-secondary": "#ffffff",
                    "on-primary-fixed-variant": "#0b513d",
                    "on-surface": "#1b1c1a",
                    "surface": "#fbf9f5",
                    "secondary-fixed-dim": "#e9c349",
                    "primary": "#003527",
                    "secondary": "#735c00",
                    "on-error-container": "#93000a",
                    "primary-container": "#064e3b",
                    "secondary-container": "#fed65b",
                    "secondary-fixed": "#ffe088",
                    "on-tertiary-fixed-variant": "#5d4200",
                    "background": "#fbf9f5",
                    "primary-fixed": "#b0f0d6",
                    "surface-dim": "#dbdad6",
                    "surface-container-lowest": "#ffffff",
                    "on-secondary-fixed": "#241a00",
                    "primary-fixed-dim": "#95d3ba",
                    "on-tertiary-fixed": "#261900",
                    "on-tertiary-container": "#daab4b",
                    "on-primary": "#ffffff",
                    "error": "#ba1a1a",
                    "on-surface-variant": "#404944",
                    "on-primary-container": "#80bea6",
                    "outline": "#707974",
                    "surface-container-low": "#f5f3ef",
                    "surface-tint": "#2b6954",
                    "tertiary": "#3e2b00",
                    "inverse-surface": "#30312e",
                    "error-container": "#ffdad6",
                    "inverse-primary": "#95d3ba",
                    "on-secondary-fixed-variant": "#574500",
                    "on-secondary-container": "#745c00",
                    "surface-bright": "#fbf9f5",
                    "on-primary-fixed": "#002117"
            },
            "borderRadius": {
                    "DEFAULT": "0.25rem",
                    "lg": "0.5rem",
                    "xl": "0.75rem",
                    "full": "9999px"
            },
            "fontFamily": {
                    "headline": ["Manrope"],
                    "body": ["Plus Jakarta Sans"],
                    "label": ["Plus Jakarta Sans"]
            }
          },
        },
      }
    </script>
<style>
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }
        .textile-pattern {
            background-image: radial-gradient(var(--tw-colors-primary-container) 0.5px, transparent 0.5px);
            background-size: 12px 12px;
        }
    </style>
<style>
    body {
      min-height: max(884px, 100dvh);
    }
  </style>
  </head>
<body class="bg-background text-on-surface font-body min-h-screen pb-12">
<!-- TopAppBar -->
<header class="flex justify-between items-center px-6 py-4 w-full z-50 backdrop-blur-md bg-[#FDFBF7] dark:bg-[#001A13] sticky top-0">
<div class="flex items-center gap-3">
<div class="w-10 h-10 rounded-full bg-primary-fixed flex items-center justify-center overflow-hidden">
<img alt="Avatar" class="w-full h-full object-cover" data-alt="close-up portrait of a professional African woman with a friendly expression and stylish attire in soft natural lighting" src="https://lh3.googleusercontent.com/aida-public/AB6AXuBKPAPFZnO_Kkvgghm7lA-kP_o6tpeBpMrCGesANZ9FW88on-ZHWSVNmsTK0EV-yEvcDCtnjRmSWPHfhbn6Coz1eXqEjXIlGrEe2YHZI0ICW5b1Ws-nbPxp00S0uqoZ0Uhrbt48ZYGudSC6x8NmAx1sSKwhHKX3awF9Swl52vWmAsm4DE22TdUbjbDAf_Lt5ggdnahA8TPFKY3Lb7aFm9EgCrbLBKoourOw6TwGP7qtdirYh_f3CG_usxv4EuCBAZKxULVZa6xDYeg"/>
</div>
<span class="text-[#003527] dark:text-[#D4AF37] text-2xl font-black font-headline">TontineChain</span>
</div>
<button class="text-[#064E3B] dark:text-[#E8F5E9] hover:opacity-80 transition-opacity">
<span class="material-symbols-outlined" data-icon="notifications">notifications</span>
</button>
</header>
<main class="max-w-2xl mx-auto px-6 py-8">
<!-- Breadcrumb / Header Title -->
<div class="mb-8">
<h1 class="font-headline font-extrabold text-3xl text-primary tracking-tight">Finaliser votre Cotisation</h1>
<p class="text-on-surface-variant mt-2">Vérifiez les détails de votre transaction sécurisée.</p>
</div>
<!-- Récapitulatif Card -->
<section class="mb-10 relative overflow-hidden bg-surface-container-lowest rounded-xl p-8 shadow-[0_8px_30px_rgb(0,53,39,0.04)]">
<!-- Decorative Top Border Pattern -->
<div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-primary via-secondary-container to-primary-container textile-pattern opacity-60"></div>
<div class="space-y-6">
<div class="flex justify-between items-start">
<div>
<span class="text-xs font-bold uppercase tracking-widest text-primary/60 font-label">Nom de la tontine</span>
<h2 class="text-xl font-bold text-primary mt-1">Cercle de Solidarité "Héritage"</h2>
</div>
<div class="bg-primary-fixed/30 p-2 rounded-lg">
<span class="material-symbols-outlined text-primary" data-icon="account_balance_wallet">account_balance_wallet</span>
</div>
</div>
<div class="grid grid-cols-1 md:grid-cols-2 gap-6 pt-4">
<div class="p-4 bg-surface-container-low rounded-xl">
<span class="text-sm text-on-surface-variant block mb-1">Montant à payer</span>
<span class="text-2xl font-extrabold text-primary">75 000 FCFA</span>
</div>
<div class="p-4 bg-surface-container-low rounded-xl">
<span class="text-sm text-on-surface-variant block mb-1">Frais blockchain</span>
<div class="flex items-center gap-2">
<span class="text-lg font-bold text-secondary">150 FCFA</span>
<span class="text-[10px] bg-secondary-container/30 px-2 py-0.5 rounded text-secondary-fixed-dim font-bold">MINIMES</span>
</div>
</div>
</div>
<div class="pt-4 mt-4 border-t border-outline-variant/10 flex justify-between items-center">
<span class="font-bold text-on-surface">Total à débiter</span>
<span class="text-2xl font-black text-primary">75 150 FCFA</span>
</div>
</div>
</section>
<!-- Choix du mode de paiement -->
<section class="mb-10">
<h3 class="font-headline font-bold text-lg text-primary mb-6">Mode de Paiement</h3>
<div class="space-y-4">
<!-- Option 1: Mobile Money -->
<label class="group relative flex items-center p-5 rounded-xl bg-surface-container-low cursor-pointer transition-all hover:bg-surface-container-high ring-1 ring-transparent has-[:checked]:ring-primary has-[:checked]:bg-white shadow-sm">
<input checked="" class="sr-only" name="payment_method" type="radio"/>
<div class="w-12 h-12 flex items-center justify-center bg-secondary-container rounded-lg mr-4">
<span class="material-symbols-outlined text-on-secondary-container" data-icon="smartphone">smartphone</span>
</div>
<div class="flex-1">
<p class="font-bold text-on-surface">Mobile Money</p>
<p class="text-xs text-on-surface-variant">MTN, Moov ou Orange Money</p>
</div>
<div class="opacity-0 group-has-[:checked]:opacity-100 text-primary">
<span class="material-symbols-outlined" data-icon="check_circle" style="font-variation-settings: 'FILL' 1;">check_circle</span>
</div>
</label>
<!-- Option 2: Wallet Crypto -->
<label class="group relative flex items-center p-5 rounded-xl bg-surface-container-low cursor-pointer transition-all hover:bg-surface-container-high ring-1 ring-transparent has-[:checked]:ring-primary has-[:checked]:bg-white shadow-sm">
<input class="sr-only" name="payment_method" type="radio"/>
<div class="w-12 h-12 flex items-center justify-center bg-primary-container rounded-lg mr-4">
<span class="material-symbols-outlined text-on-primary-container" data-icon="currency_bitcoin">currency_bitcoin</span>
</div>
<div class="flex-1">
<p class="font-bold text-on-surface">Portefeuille Crypto</p>
<p class="text-xs text-on-surface-variant">USDT, USDC ou ETH (Layer 2)</p>
</div>
<div class="opacity-0 group-has-[:checked]:opacity-100 text-primary">
<span class="material-symbols-outlined" data-icon="check_circle" style="font-variation-settings: 'FILL' 1;">check_circle</span>
</div>
</label>
</div>
</section>
<!-- Actions and Security -->
<div class="space-y-6">
<button class="w-full py-5 bg-gradient-to-r from-primary to-primary-container text-white rounded-xl font-bold text-lg shadow-lg hover:opacity-95 active:scale-[0.98] transition-all flex items-center justify-center gap-3">
<span class="material-symbols-outlined" data-icon="send">send</span>
                Confirmer et Envoyer
            </button>
<div class="flex flex-col items-center justify-center gap-3 text-center">
<div class="flex items-center gap-2 text-primary/60 bg-surface-container-low px-4 py-2 rounded-full border border-outline-variant/10">
<span class="material-symbols-outlined text-sm" data-icon="verified_user">verified_user</span>
<span class="text-xs font-medium">Transaction cryptée et immuable.</span>
</div>
<p class="text-[10px] text-on-surface-variant max-w-xs mx-auto">
                    En cliquant sur confirmer, vous autorisez TontineChain à traiter cette transaction via les protocoles de sécurité blockchain.
                </p>
</div>
</div>
</main>
<!-- Success Illustration (Floating Decor) -->
<div class="fixed top-1/2 -right-24 -translate-y-1/2 opacity-5 pointer-events-none hidden xl:block">
<div class="w-96 h-96 rounded-full border-[32px] border-secondary-container textile-pattern"></div>
</div>
<!-- BottomNavBar (Suppressed for focused Payment action as per hierarchy rules, but keeping a subtle back link) -->
<div class="fixed bottom-6 left-1/2 -translate-x-1/2">
<a class="flex items-center gap-2 text-on-surface-variant hover:text-primary transition-colors text-sm font-semibold" href="#">
<span class="material-symbols-outlined text-lg" data-icon="arrow_back">arrow_back</span>
            Retourner au contrat
        </a>
</div>
</body></html>
