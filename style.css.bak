<section class="mb-12 relative overflow-hidden rounded-[2rem] bg-primary p-8 md:p-12 text-on-primary shadow-2xl">
<div class="absolute inset-0 pattern-overlay opacity-50"></div>
<div class="relative z-10 max-w-2xl">
<h1 class="font-headline font-extrabold text-4xl md:text-5xl mb-6 leading-tight">Patrimoine &amp; <br/><span class="text-secondary-container">Solidarité</span></h1>
<p class="text-on-primary-container text-lg mb-8 opacity-90">Trouvez une tontine de confiance qui correspond à vos objectifs d'épargne et rejoignez une communauté engagée.</p>
<!-- Search Bar -->
<div class="bg-surface-container-lowest rounded-2xl p-2 flex flex-col md:flex-row gap-2 shadow-lg">
<div class="flex-grow flex items-center px-4 py-3 bg-surface-container-low rounded-xl">
<span class="material-symbols-outlined text-outline mr-3" data-icon="search">search</span>
<input class="bg-transparent border-none focus:ring-0 w-full text-on-surface placeholder:text-outline" placeholder="Rechercher par nom ou ville..." type="text"/>
</div>
