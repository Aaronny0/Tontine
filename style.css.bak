<img class="w-full h-full object-cover" data-alt="Portrait of a professional West African man in a smart suit, warm lighting, studio background" src="https://lh3.googleusercontent.com/aida-public/AB6AXuBPOyuiOlGO01xn6V380goM02p0dO9vc9IS-HaJOA9D4VXzUSNL-1b8RQjc6zakiY8V-Pee-q53rd2kvwGf-CsnLQEh_0qQSMN7JDJfgDD2LKjYxi0Tv_tUv595ht3VFlrziFofIWVtRtD-FffQTQxO0dSBYjCURDKa53QfBpne16psIeyDPl2aMa9xHa4Pt97_m9zCM_W5DEhqX5-qJHrHAUNkbuEgKWFBMKiWhUcU06LC5SR1uMJ3B2jqPjb5E2M3_rvM8b7zbbc"/>
</div>
