<body class="bg-background font-body text-on-surface overflow-hidden h-screen flex flex-col">
<!-- TopAppBar Fragment from Shared Components -->
<header class="bg-[#FDFBF7] dark:bg-[#001A13] flex justify-between items-center px-6 py-4 w-full z-50 backdrop-blur-md sticky top-0">
<div class="flex items-center gap-4">
<button class="text-primary hover:opacity-80 transition-opacity">
<span class="material-symbols-outlined">arrow_back</span>
</button>
<div class="flex items-center gap-3">
<div class="w-10 h-10 rounded-xl overflow-hidden bg-primary-container flex items-center justify-center">
<img class="w-full h-full object-cover opacity-90" data-alt="Group of diverse professional entrepreneurs collaborating around a table in a modern office with warm lighting" src="https://lh3.googleusercontent.com/aida-public/AB6AXuCvip2PhJNaJg5Bauh4hi2BfTgKk2WT__0dF4vPLvHUvPXwMFpoofxs5tVcFbuJe8tNw5ltAzIZ8O28wlLihUQySXK3pT_o8U_Nc9RCjspxizsddd3a6TGNaMJmYpXUBP-gYyV6ufjlgqPIPL5VwaCRVZx_fsEMDaLKCArIShSOMGzhNvbARmcfjQuKXkHr3vrDAknt86LjSZJpqqXznnnsvBKhgQxTpWWNqCJcj1xDbJvq1Qeh2f7Ms0fJS4FKlPWPPiBW2Q4zaZs"/>
</div>
<div>
<h1 class="font-headline font-bold text-lg text-primary">Cercle des Entrepreneurs</h1>
<p class="text-[10px] text-primary/60 font-medium uppercase tracking-wider">12 Membres actifs</p>
</div>
</div>
</div>
<div class="flex items-center gap-2">
