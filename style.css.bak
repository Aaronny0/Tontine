<body class="bg-background font-body text-on-background min-h-screen">
<!-- Top Navigation Anchor -->
<header class="bg-[#FDFBF7] dark:bg-[#001A13] flex justify-between items-center px-6 py-4 w-full z-50 backdrop-blur-md sticky top-0">
<div class="flex items-center gap-3">
<button class="hover:opacity-80 transition-opacity">
<span class="material-symbols-outlined text-primary">arrow_back_ios</span>
</button>
<span class="font-['Manrope'] font-bold text-xl text-[#064E3B] dark:text-[#E8F5E9]">Inviter &amp; Partager</span>
</div>
<div class="flex items-center gap-2">
<span class="material-symbols-outlined text-[#064E3B] dark:text-[#E8F5E9] cursor-pointer hover:opacity-80 transition-opacity">notifications</span>
<div class="w-8 h-8 rounded-full overflow-hidden border border-outline-variant">
<img class="w-full h-full object-cover" data-alt="portrait of a confident man with dark skin, smiling warmly, professional business photography style" src="https://lh3.googleusercontent.com/aida-public/AB6AXuCjP0cmjzd2dmn8ApqGtMQOZNERygn2vp6_VHYa7eVfKBznLZqDuY7pYjgAx62IuQTp4RfpVyjyAc4xZpSeBX0cP3yDJLcsjA4Kr2peD6KCuXibHF5HYXppLcHzJu5t2qvNFO8DEQLhsSvdSiUQGvLUxNLfa-ANCNPybmbgqyXVCXL1msFOKhRVglCSvgF32UicbtRtAp2mgCBIj8nTO0527wMffnAAo8oyxwcvdyM8ZZrUrGVL6Oro1DVWaAhsofp9DxNf-azwbJk"/>
</div>
</div>
</header>
<main class="max-w-md mx-auto px-6 py-8 pb-32 pattern-overlay">
<!-- Hero Section -->
<div class="text-center mb-10">
<h1 class="font-headline font-extrabold text-3xl text-primary tracking-tight mb-2">Invitez vos proches</h1>
<p class="text-on-surface-variant font-medium">Partagez la sécurité de TontineChain.</p>
</div>
<!-- QR Code Centered Section -->
<div class="relative mb-12">
<div class="bg-surface-container-lowest rounded-3xl p-8 shadow-[0_20px_50px_rgba(0,53,39,0.08)] flex flex-col items-center">
<div class="relative p-4 bg-white rounded-2xl border-4 border-surface-container-high">
<!-- Representing a QR Code with a styled div since we cannot use external dynamic generators easily -->
<div class="w-48 h-48 bg-[#003527] rounded-lg flex items-center justify-center relative overflow-hidden">
<!-- Simulated QR Pattern -->
<div class="absolute inset-0 grid grid-cols-6 grid-rows-6 gap-1 p-1 opacity-20">
<div class="bg-white"></div><div class="bg-white"></div><div class="bg-white"></div><div class="bg-white"></div><div class="bg-white"></div><div class="bg-white"></div>
<div class="bg-white"></div><div class="bg-white"></div><div class="bg-white"></div><div class="bg-white"></div><div class="bg-white"></div><div class="bg-white"></div>
<div class="bg-white"></div><div class="bg-white"></div><div class="bg-white"></div><div class="bg-white"></div><div class="bg-white"></div><div class="bg-white"></div>
</div>
<span class="material-symbols-outlined text-secondary-container text-6xl relative z-10" data-weight="fill">qr_code_2</span>
</div>
</div>
<!-- Access Code Section -->
<div class="mt-8 text-center">
<span class="text-label-md font-bold text-on-surface-variant uppercase tracking-widest block mb-2">Code d'accès</span>
<div class="flex gap-2">
<span class="w-10 h-14 flex items-center justify-center bg-surface-container-low rounded-xl text-2xl font-bold text-primary border border-outline-variant/20">7</span>
<span class="w-10 h-14 flex items-center justify-center bg-surface-container-low rounded-xl text-2xl font-bold text-primary border border-outline-variant/20">2</span>
