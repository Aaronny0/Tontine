<body class="bg-background font-body text-on-background min-h-screen pb-32">
<!-- TopAppBar -->
<header class="bg-[#FDFBF7] dark:bg-[#001A13] flex justify-between items-center px-6 py-4 w-full z-50 backdrop-blur-md sticky top-0">
<div class="flex items-center gap-3">
<div class="w-10 h-10 rounded-full overflow-hidden bg-primary-fixed ring-2 ring-primary-container/10">
<img alt="Avatar" class="w-full h-full object-cover" data-alt="Portrait of a professional African woman with a warm smile and modern hairstyle in soft natural light" src="https://lh3.googleusercontent.com/aida-public/AB6AXuCv_AZXFw2CIsz7x5F28aOcnm-JG8yCQ1rmIDWE_LVYJyVvkEdmeGaAM3rJKXCt4LGwGbyYHNTgU0mldRvICs-F6vVpNIAzWdsRarwk4jEqZ1jzIttyYJ_AwqH--Dzgw-OWLkXCAxmLHYC2jhvgQRIYGE8NZ5r8ug0g0ERTqVlMjaQG8LeA3uhumtX4Zm7pbobMo6x5fa2bZLgqtLKLb_rKkACw_-Vwg3pPbfq3F_jdqjd6O8xkna9U7_ZPtfrBqLDfhnvJiZxgOXs"/>
